# Copy this file to .env and fill in the values. Never commit .env itself.
# In Lovable Cloud these are injected for you — this file documents what the
# app reads so a local checkout can run without guessing.

# ---------------------------------------------------------------------------
# Supabase — server side
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
# Injected by Lovable Cloud; not read directly by the app code.
SUPABASE_PROJECT_ID=your-project-ref

# Bypasses RLS — server-only. Never expose this to the browser and never
# prefix it with VITE_. Used by the leaderboard read/write server functions.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Supabase — browser side (VITE_ vars are inlined into the client bundle,
# so only ever put public values here)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
# Injected by Lovable Cloud; not read directly by the app code.
VITE_SUPABASE_PROJECT_ID=your-project-ref

# ---------------------------------------------------------------------------
# AI provider for fit analysis (/live, /check, Compare with my style).
# Set GEMINI_API_KEY for local dev with your own Google AI Studio key.
# On Lovable Cloud, LOVABLE_API_KEY is provided instead and takes over
# automatically when GEMINI_API_KEY is absent.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your-google-ai-studio-key
# LOVABLE_API_KEY=provided-by-lovable-cloud
